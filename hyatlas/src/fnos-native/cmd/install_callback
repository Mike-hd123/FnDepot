#!/bin/bash
# 安装后置（v4.1.1-3 降权版）：以 root 跑（privilege run-as:root + username 声明）
# 职责：运行用户兜底 + 数据/运行时/模型属主与可读性修复（清理 root 时代遗留）
set -u
LOG="${TRIM_PKGVAR:-/vol1/@appdata/hyatlas}/install.log"
mkdir -p "${TRIM_PKGVAR:-/vol1/@appdata/hyatlas}"
echo "===== install_callback $(date) =====" > "$LOG"

APP_DIR="${TRIM_APPDEST:-/vol1/@appcenter/hyatlas}"
APP_SHARE="${TRIM_SHARE_DIR:-}"
if [ -z "${APP_SHARE}" ]; then
  APP_SHARE="/var/apps/hyatlas/shares"
fi
SHARE_ROOT="${APP_SHARE}/hyatlas"
DATA_DIR="${SHARE_ROOT}/go-data"
RUN_USER="${TRIM_USERNAME:-hy-memory}"
RUN_GROUP="${TRIM_GROUPNAME:-hy-memory}"

# 0) 运行用户兜底（正常路径由 fnOS 安装器按 privilege username 建户并注入 TRIM_USERNAME）
if ! id "$RUN_USER" >/dev/null 2>&1; then
  getent group "$RUN_GROUP" >/dev/null 2>&1 || groupadd "$RUN_GROUP" 2>/dev/null || true
  useradd --system --no-create-home -g "$RUN_GROUP" -s /usr/sbin/nologin "$RUN_USER" 2>/dev/null || true
fi
if ! id "$RUN_USER" >/dev/null 2>&1; then
  echo "FATAL: run user ${RUN_USER} missing and auto-create failed" >> "$LOG"
  exit 1
fi
RUN_GRP="$(id -gn "$RUN_USER" 2>/dev/null || echo "$RUN_GROUP")"

# 1) 数据目录 + 属主（历史 root 属主文件一并归还，防降权后写失败）
mkdir -p "${DATA_DIR}"
chown -R "${RUN_USER}:${RUN_GRP}" "${DATA_DIR}" 2>/dev/null || true
echo "data dir ready: ${DATA_DIR} (owner ${RUN_USER})" >> "$LOG"

# 1a) shares 实体化自愈（幂等）：
# 安装/升级时 fnOS 安装器可能把 /var/apps/hyatlas/shares 重建为实体目录，
# 导致应用读到的数据是空壳、真库留在 /vol1/@appshare（4.1.1-4 改名包后数据空已发生两次）。
# 治理：真库(/vol1/@appshare/hyatlas/go-data)存在且 shares 为实体目录 → 清空壳、重建软链 shares -> /vol1/@appshare；
#       shares 已是软链 → 跳过；全新安装(appshare 无 go-data) → 建 /vol1/@appshare/hyatlas/go-data + 软链。
SHARES_LINK="/var/apps/hyatlas/shares"
SHARE_SRC="/vol1/@appshare"
if [ -L "${SHARES_LINK}" ]; then
  echo "shares is already a symlink -> $(readlink "${SHARES_LINK}"), skip" >> "$LOG"
else
  echo "shares is NOT a symlink (type: $(stat -c %F "${SHARES_LINK}" 2>/dev/null || echo missing)), healing" >> "$LOG"
  # 实体目录移开留底（不直接 rm：若实体目录内有升级间隙的新写入数据可从 bak 找回），保留最近 2 份
  if [ -e "${SHARES_LINK}" ] && [ ! -L "${SHARES_LINK}" ]; then
    BAK="${SHARES_LINK}.entity-bak-$(date +%Y%m%d%H%M%S)"
    mv "${SHARES_LINK}" "${BAK}" || { echo "FATAL: cannot move entity shares dir aside" >> "$LOG"; exit 1; }
    echo "moved entity dir aside: ${BAK} (若其中有新写入数据，从该目录找回)" >> "$LOG"
    ls -1dt "${SHARES_LINK}".entity-bak-* 2>/dev/null | tail -n +3 | xargs -r rm -rf
  fi
  mkdir -p "${SHARE_SRC}/hyatlas/go-data"
  ln -sfn "${SHARE_SRC}" "${SHARES_LINK}" || { echo "FATAL: ln -s shares failed" >> "$LOG"; exit 1; }
  echo "healed: relinked ${SHARES_LINK} -> ${SHARE_SRC} (data dir ${SHARE_SRC}/hyatlas/go-data)" >> "$LOG"
  # 自愈后数据属主归还运行用户
  chown -R "${RUN_USER}:${RUN_GRP}" "${SHARE_SRC}/hyatlas" 2>/dev/null || true
fi

# 1b) 运行时目录/文件（日志、pid、HOME、TMPDIR）属主归还
VAR_DIR="${TRIM_PKGVAR:-/vol1/@appdata/hyatlas}"
chown -R "${RUN_USER}:${RUN_GRP}" "${VAR_DIR}" 2>/dev/null || true
mkdir -p "${VAR_DIR}/home" "${VAR_DIR}/tmp" 2>/dev/null || true
chown "${RUN_USER}:${RUN_GRP}" "${VAR_DIR}/home" "${VAR_DIR}/tmp" 2>/dev/null || true
chmod 700 "${VAR_DIR}/tmp" 2>/dev/null || true

# 2) 二进制可执行
chmod 755 "${APP_DIR}/hyatlas-go" 2>/dev/null || true
echo "binary ready: ${APP_DIR}/hyatlas-go" >> "$LOG"

# 3) 网关 sidecar 可读可执行
if [ -f "${APP_DIR}/gateway/gateway_proxy.py" ]; then
  chmod 755 "${APP_DIR}/gateway" 2>/dev/null || true
  chmod 644 "${APP_DIR}/gateway/gateway_proxy.py" 2>/dev/null || true
  echo "gateway sidecar ready" >> "$LOG"
else
  echo "WARN: gateway_proxy.py missing in APPDEST" >> "$LOG"
fi

# 4) B2: 内置模型目录可读 (ORT int8 bge-large-zh, 由运行用户加载)
if [ -d "${APP_DIR}/models" ]; then
  chmod 755 "${APP_DIR}/models" 2>/dev/null || true
  chmod 644 "${APP_DIR}/models/model_int8.onnx" "${APP_DIR}/models/tokenizer.json" 2>/dev/null || true
  chmod 755 "${APP_DIR}/models/libonnxruntime.so" 2>/dev/null || true
  echo "embedded models ready: ${APP_DIR}/models" >> "$LOG"
else
  echo "WARN: models/ missing in APPDEST (B2 内置引擎将无法加载)" >> "$LOG"
fi

echo "===== done (run-as ${RUN_USER}) =====" >> "$LOG"
exit 0
