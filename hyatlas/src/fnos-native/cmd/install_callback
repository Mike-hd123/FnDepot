#!/bin/bash
set -u
LOG="${TRIM_PKGVAR:-/vol1/@appdata/hyatlas}/install.log"
mkdir -p "${TRIM_PKGVAR:-/vol1/@appdata/hyatlas}"
echo "===== install_callback $(date) ===== > $LOG"

APP_DIR="${TRIM_APPDEST:-/vol1/@appcenter/hyatlas}"
APP_SHARE="${TRIM_SHARE_DIR:-}"
if [ -z "${APP_SHARE}" ]; then
  APP_SHARE="/var/apps/hyatlas/shares"
fi
SHARE_ROOT="${APP_SHARE}/hyatlas"
DATA_DIR="${SHARE_ROOT}/go-data"
RUN_USER="${TRIM_USERNAME:-hy-memory}"
RUN_GROUP="${TRIM_GROUPNAME:-hy-memory}"

# 1) 数据目录 + 属主
mkdir -p "${DATA_DIR}"
chown -R "${RUN_USER}:${RUN_GROUP}" "${DATA_DIR}" 2>/dev/null || true
echo "data dir ready: ${DATA_DIR}" >> "$LOG"

# 2) 二进制可执行
chmod 755 "${APP_DIR}/hyatlas-go" 2>/dev/null || true
echo "binary ready: ${APP_DIR}/hyatlas-go" >> "$LOG"

# 3) 网关 sidecar 可读可执行
if [ -f "${APP_DIR}/gateway/gateway_proxy.py" ]; then
  chmod 755 "${APP_DIR}/gateway" 2>/dev/null || true
  chmod 644 "${APP_DIR}/gateway/gateway_proxy.py" 2>/dev/null || true
  echo "gateway sidecar ready" >> "$LOG"
else
  echo "WARN: gateway_proxy.py missing in APPDEST" >> "$LOG"
fi

echo "===== done =====" >> "$LOG"
exit 0