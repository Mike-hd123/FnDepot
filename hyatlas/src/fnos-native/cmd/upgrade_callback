#!/bin/bash
# 升级后置（v4.7.3-2 合规修复版）：share 两跳解析 + 软链校验 + 幂等迁移 + 属主归还
# 背景：fnOS 安装器在升级时可能把 /var/apps/hyatlas/shares 重建为实体目录，
#       导致升级后读到空壳库、真库留在 appshare（v4 升级、4.1.1-4 改名装均已发生）。
# 本轮把主路径解析改成官方两跳写法（优先读 /var/apps/<app>/shares/<name> 软链本身），
# 因此软链状态校验成为必需闸门；迁移通道在本脚本里必须极端保守（只拷不删不 mv）。
set -u
LOG="${TRIM_PKGVAR:-/vol1/@appdata/hyatlas}/install.log"
mkdir -p "${TRIM_PKGVAR:-/vol1/@appdata/hyatlas}" 2>/dev/null || true
echo "===== upgrade_callback $(date) =====" >> "$LOG"

APP_DIR="${TRIM_APPDEST:-/vol1/@appcenter/hyatlas}"

# ── share 根目录：官方两跳解析（四个生命周期脚本各内联一份，禁止 source 兄弟文件）──
resolve_share_root() {
  local _app="$1" _name="$2" _paths="$3" _c
  for _c in "/var/apps/${_app}/shares/${_name}" "${_paths%%:*}"; do
    [ -n "${_c}" ] || continue
    case "${_c}" in /vol0/*) continue ;; esac
    if [ -d "${_c}" ] || mkdir -p "${_c}" 2>/dev/null; then
      printf '%s\n' "${_c}"
      return 0
    fi
  done
  return 1
}

die() {
  echo "FATAL: $1" >&2
  [ -n "${TRIM_TEMP_LOGFILE:-}" ] && echo "FATAL: $1" > "${TRIM_TEMP_LOGFILE}"
  exit 1
}

_cov="${TRIM_SHARE_DIR:-}"
if [ -n "${_cov}" ]; then
  SHARE_ROOT="${_cov%/}/hyatlas"
else
  SHARE_ROOT="$(resolve_share_root hyatlas hyatlas "${TRIM_DATA_SHARE_PATHS:-}")" || SHARE_ROOT=""
fi
SHARE_ROOT="${SHARE_ROOT:-/var/apps/hyatlas/shares/hyatlas}"
APP_SHARE="$(dirname "${SHARE_ROOT}")"
DATA_DIR="${SHARE_ROOT}/go-data"
RUN_USER="${TRIM_USERNAME:-hy-memory}"
RUN_GROUP="${TRIM_GROUPNAME:-hy-memory}"
if ! id "$RUN_USER" >/dev/null 2>&1; then
  getent group "$RUN_GROUP" >/dev/null 2>&1 || groupadd "$RUN_GROUP" 2>/dev/null || true
  useradd --system --no-create-home -g "$RUN_GROUP" -s /usr/sbin/nologin "$RUN_USER" 2>/dev/null || true
fi
RUN_GRP="$(id -gn "$RUN_USER" 2>/dev/null || echo "$RUN_GROUP")"

# ── shares 软链存在性校验（保留历史兜底；不破坏性：实体目录先 mv 留底，绝不 rm）──
SHARES_LINK="/var/apps/hyatlas/shares"
SHARE_SRC="${APP_SHARE}"
if [ -L "${SHARES_LINK}" ]; then
  echo "shares symlink ok -> $(readlink "${SHARES_LINK}") (resolved share root: ${SHARE_ROOT})" >> "$LOG"
elif [ -e "${SHARES_LINK}" ]; then
  echo "WARN: shares is NOT a symlink (type: $(stat -c %F "${SHARES_LINK}" 2>/dev/null || echo unknown)), healing" >> "$LOG"
  BAK="${SHARES_LINK}.entity-bak-$(date +%Y%m%d%H%M%S)"
  if mv "${SHARES_LINK}" "${BAK}" 2>/dev/null; then
    echo "moved entity dir aside: ${BAK} (若其中有新写入数据，从该目录找回)" >> "$LOG"
    ls -1dt "${SHARES_LINK}".entity-bak-* 2>/dev/null | tail -n +3 | xargs -r rm -rf
    mkdir -p "${SHARE_SRC}/hyatlas/go-data" 2>/dev/null || true
    ln -sfn "${SHARE_SRC}" "${SHARES_LINK}" \
      && echo "healed: relinked ${SHARES_LINK} -> ${SHARE_SRC}" >> "$LOG" \
      || echo "FATAL: ln -s shares failed (数据仍在 ${SHARE_SRC}/hyatlas)" >> "$LOG"
  else
    echo "FATAL: cannot move entity shares dir aside (数据仍在 ${SHARE_SRC}/hyatlas)" >> "$LOG"
  fi
else
  echo "shares link missing, ensuring ${SHARE_SRC}/hyatlas" >> "$LOG"
  mkdir -p "${SHARE_SRC}/hyatlas/go-data" 2>/dev/null || true
  ln -sfn "${SHARE_SRC}" "${SHARES_LINK}" 2>/dev/null || true
fi

mkdir -p "${DATA_DIR}" || die "无法创建 share 数据目录 ${DATA_DIR}"

# ── 幂等迁移（存量库进 share 的主通道）：只在目标为空时 cp -a，绝不 mv、绝不删源 ──
MIG_LOG="${TRIM_PKGVAR:-/vol1/@appdata/hyatlas}/migrate.log"
if [ -z "$(ls -A "${DATA_DIR}" 2>/dev/null)" ]; then
  for OLD in \
    "${TRIM_PKGVAR:-/vol1/@appdata/hyatlas}/go-data" \
    "${TRIM_PKGVAR:-/vol1/@appdata/hyatlas}/data" \
    "${TRIM_APPDEST:-/vol1/@appcenter/hyatlas}/go-data" \
    "${TRIM_APPDEST:-/vol1/@appcenter/hyatlas}/data" ; do
    if [ -d "$OLD" ] && [ -n "$(ls -A "$OLD" 2>/dev/null)" ]; then
      if cp -a "$OLD/." "${DATA_DIR}/" 2>/dev/null; then
        echo "$(date) migrated: $OLD -> ${DATA_DIR} (source kept)" >> "$MIG_LOG" 2>/dev/null || true
        echo "migrated old data: $OLD -> ${DATA_DIR}" >> "$LOG"
        break
      else
        echo "$(date) migrate FAILED: $OLD" >> "$MIG_LOG" 2>/dev/null || true
      fi
    fi
  done
  echo "migrate pass done (target was empty)" >> "$LOG"
else
  echo "share data dir not empty, migration skipped (no overwrite)" >> "$LOG"
fi

# ── 数据/运行时属主归还（防 root 遗留卡住降权进程）──
VAR_DIR="${TRIM_PKGVAR:-/vol1/@appdata/hyatlas}"
chown -R "${RUN_USER}:${RUN_GRP}" "${DATA_DIR}" 2>/dev/null || true
chown -R "${RUN_USER}:${RUN_GRP}" "${VAR_DIR}" 2>/dev/null || true

# ── 二进制/网关/模型可执行可读 ──
chmod 755 "${APP_DIR}/hyatlas-go" 2>/dev/null || true
chmod 644 "${APP_DIR}/gateway/gateway_proxy.py" 2>/dev/null || true
chmod 755 "${APP_DIR}/models/libonnxruntime.so" 2>/dev/null || true

# ── env 补键（v4.3.0 配置化）：模板新增键补入现役 env，绝不覆盖已有值 ──
ENV_F="${VAR_DIR}/env"
TPL="${APP_DIR}/env.example"
if [ -f "$ENV_F" ] && [ -f "$TPL" ]; then
  ADDED=0
  while IFS='=' read -r k _; do
    case "$k" in \#*|"") continue ;; esac
    grep -qE "^[[:space:]]*#?${k}=" "$ENV_F" || { printf '%s=%s\n' "$k" "$(grep -m1 "^${k}=" "$TPL" | cut -d= -f2-)" >> "$ENV_F"; ADDED=$((ADDED+1)); }
  done < "$TPL"
  chown "${RUN_USER}:${RUN_GRP}" "$ENV_F" 2>/dev/null || true
  chmod 600 "$ENV_F" 2>/dev/null || true
  echo "env merge: ${ADDED} new key(s) appended, existing values preserved" >> "$LOG"
elif [ ! -f "$ENV_F" ] && [ -f "$TPL" ]; then
  cp "$TPL" "$ENV_F"; chown "${RUN_USER}:${RUN_GRP}" "$ENV_F" 2>/dev/null || true; chmod 600 "$ENV_F" 2>/dev/null || true
  echo "env created from template during upgrade: $ENV_F" >> "$LOG"
fi

echo "===== upgrade_callback done (run-as ${RUN_USER}) =====" >> "$LOG"
exit 0
