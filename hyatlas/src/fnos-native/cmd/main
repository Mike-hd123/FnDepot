#!/bin/bash
# cmd/main — HyAtlas v4 (Go) 进程管理（v4.1.1-3 降权版）
# 应用监听 TCP 19528 (loopback)；gateway sidecar 监听 APPDEST/app.sock 转 TCP（手机端 /app/hyatlas 路由）
# v4.1.1-3: 进程以专用用户运行（privilege username=hy-memory；installer 注入 TRIM_USERNAME）。
#           root 调用时经 setpriv 降权拉起；以运行用户身份调用时直跑。数据/日志/pid 均落在该用户可写路径。
set -u

APP_DIR="${TRIM_APPDEST:-/vol1/@appcenter/hyatlas}"
# 数据目录: 复用现役 v3 的 /var/apps/hyatlas/shares (→ /vol1/@appshare/hyatlas)，v4 数据子目录独立于 v3
APP_SHARE="${TRIM_SHARE_DIR:-}"
if [ -z "${APP_SHARE}" ]; then
  APP_SHARE="/var/apps/hyatlas/shares"
fi
SHARE_ROOT="${APP_SHARE}/hyatlas"
DATA_DIR="${SHARE_ROOT}/go-data"
VAR_DIR="${TRIM_PKGVAR:-/vol1/@appdata/hyatlas}"
LOG_FILE="${VAR_DIR}/panel.log"
PID_FILE="${VAR_DIR}/panel.pid"
GW_PID_FILE="${VAR_DIR}/gateway.pid"

# ── 运行用户（install_callback 兜底保证存在；正常路径由 installer 注入 TRIM_USERNAME）──
RUN_USER="${TRIM_USERNAME:-hy-memory}"

# ── HOME/TMPDIR: ORT 推理缓存写 $HOME/.cache，必须落 VAR_DIR（不能写 /root）──
export HOME="${VAR_DIR}/home"
export TMPDIR="${VAR_DIR}/tmp"
mkdir -p "$HOME" "$TMPDIR" 2>/dev/null || true
chmod 700 "$TMPDIR" 2>/dev/null || true

# ── 可写性自愈: 历史以 root 跑时遗留的 root 属主日志/pid 会卡住降权进程。
# 以「运行用户」身份探测可写性（root 万能写，root 自测无意义），不可写即删除重建 ──
for f in "$LOG_FILE" "${VAR_DIR}/gateway.log" "$PID_FILE" "$GW_PID_FILE"; do
  [ -e "$f" ] || continue
  if [ "$(id -u)" = "0" ] && [ -n "${RUN_UID:-}" ] && [ -n "${RUN_GID:-}" ]; then
    if ! setpriv --reuid="$RUN_UID" --regid="$RUN_GID" --init-groups test -w "$f" 2>/dev/null; then
      rm -f "$f" 2>/dev/null || true
    fi
  else
    [ -w "$f" ] || rm -f "$f" 2>/dev/null || true
  fi
done

# ── 日志文件属主归一: root 身份下若日志不存在,重定向会以 root 建文件 → 下轮降权写不进。预先建好并归运行用户 ──
for f in "$LOG_FILE" "${VAR_DIR}/gateway.log"; do
  [ -e "$f" ] || : > "$f" 2>/dev/null || true
  [ -n "${RUN_UID:-}" ] && [ -n "${RUN_GID:-}" ] && chown "${RUN_UID}:${RUN_GID}" "$f" 2>/dev/null || true
done

mkdir -p "${DATA_DIR}" "${VAR_DIR}" 2>/dev/null || true

RUN_UID="$(id -u "$RUN_USER" 2>/dev/null || true)"
RUN_GID="$(id -g "$RUN_USER" 2>/dev/null || true)"

# as_user: 用 exec 保证 & 后台子 shell 直接变成目标进程（PID_FILE 记录的就是服务本身）
as_user() {
  if [ -n "${RUN_UID:-}" ] && [ "$(id -u)" = "$RUN_UID" ]; then
    exec nohup "$@"
  elif [ "$(id -u)" = "0" ] && [ -n "${RUN_UID:-}" ] && [ -n "${RUN_GID:-}" ]; then
    exec nohup setpriv --reuid="$RUN_UID" --regid="$RUN_GID" --init-groups --inh-caps=-all "$@"
  else
    echo "WARN: cannot drop privileges to ${RUN_USER} (uid=${RUN_UID:-} gid=${RUN_GID:-}), starting as $(id -un)" >&2
    exec nohup "$@"
  fi
}

is_running() {
  if [ -f "$PID_FILE" ]; then
    local pid
    pid=$(cat "$PID_FILE" 2>/dev/null)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
  fi
  # 兜底(2026-09-27)：as_user 里 exec 前的 & 子 shell 让 $! 记成已退出的过渡 PID，
  # 导致 panel.pid 与真身 hyatlas-go 错位、status 误判停用。按进程名找回真身并回写校准。
  local real
  real=$(pgrep -x hyatlas-go 2>/dev/null | head -1)
  if [ -n "$real" ]; then
    echo "$real" > "$PID_FILE" 2>/dev/null || true
    return 0
  fi
  return 1
}

gw_running() {
  [ -f "$GW_PID_FILE" ] && kill -0 "$(cat "$GW_PID_FILE" 2>/dev/null)" 2>/dev/null
}

stop_app() {
  if is_running; then
    pid=$(cat "$PID_FILE")
    kill "$pid" 2>/dev/null
    sleep 3
    kill -9 "$pid" 2>/dev/null || true
    rm -f "$PID_FILE"
  fi
}

stop_gw() {
  if [ -f "$GW_PID_FILE" ]; then
    gwpid=$(cat "$GW_PID_FILE" 2>/dev/null)
    if [ -n "$gwpid" ] && kill -0 "$gwpid" 2>/dev/null; then
      kill "$gwpid" 2>/dev/null
      sleep 1
      kill -9 "$gwpid" 2>/dev/null || true
    fi
    rm -f "$GW_PID_FILE"
  fi
  rm -f "${APP_DIR}/app.sock" 2>/dev/null || true
}

case "${1:-}" in
  start)
    is_running && gw_running && exit 0
    # ── 配置装载（v4.3.0 配置化）：优先级 shell 环境 > ${VAR_DIR}/env > 内置默认 ──
    ENV_FILE="${VAR_DIR}/env"
    if [ -f "$ENV_FILE" ]; then
      # set -a: 文件内所有键自动 export 给子进程（server 只读环境变量；仅 source
      # 不导出会让 HYATLAS_EMBED_KEY 等静默丢失——2026-10-08 401 事故根因）
      set -a
      # shellcheck disable=SC1090
      . "$ENV_FILE"
      set +a
    fi
    # ── 旧键名兼容（4.2.0-4 时代 env 的别名，缺失才映射，不覆盖新键）──
    [ -z "${HYATLAS_EMBED_KEY:-}" ]  && [ -n "${HYATLAS_EMBED_API_KEY:-}" ] && export HYATLAS_EMBED_KEY="$HYATLAS_EMBED_API_KEY"
    [ -z "${HYATLAS_LLM_BASE:-}" ]   && [ -n "${HYATLAS_LLM_BASE_URL:-}" ]  && export HYATLAS_LLM_BASE="$HYATLAS_LLM_BASE_URL"
    export HYATLAS_GO_HOST="${HYATLAS_GO_HOST:-127.0.0.1}"
    export HYATLAS_GO_PORT="${HYATLAS_GO_PORT:-19528}"
    export HYATLAS_GO_DATA="${HYATLAS_GO_DATA:-${DATA_DIR}}"
    # v4.3.0 抽取模式阶梯：lite/pro/ultra。非法值会 fatal 退出（防误配静默升级），
    # 默认 ultra：与 fork 此前"每轮全层+图谱"行为最接近（L5/L6 改由慢路径产出）。
    export HYATLAS_MODE="${HYATLAS_MODE:-ultra}"
    [ -n "${HYATLAS_SYNC_EXTRACT:-}" ] && export HYATLAS_SYNC_EXTRACT
    [ -n "${HYATLAS_CONSOLIDATE_EVERY:-}" ] && export HYATLAS_CONSOLIDATE_EVERY
    [ -n "${HYATLAS_CONSOLIDATE_BATCH:-}" ] && export HYATLAS_CONSOLIDATE_BATCH
    [ -n "${HYATLAS_RAW_RETENTION:-}" ] && export HYATLAS_RAW_RETENTION
    # 向量引擎：默认本机 embedding wrapper (18080, bge-large-zh 1024d)；
    # HYATLAS_EMBED_BASE=bge 回退包内进程内 ORT int8。
    export HYATLAS_EMBED_BASE="${HYATLAS_EMBED_BASE:-http://127.0.0.1:18080/v1}"
    export HYATLAS_EMBED_MODEL="${HYATLAS_EMBED_MODEL:-bge-large-zh-v1.5}"
    export HYATLAS_MODEL_DIR="${HYATLAS_MODEL_DIR:-${APP_DIR}/models}"
    # fork L7 防膨胀旋钮默认（详见 server.go promoteExtraction / handleSearch）
    export HYATLAS_L7_DEDUP_THRESHOLD="${HYATLAS_L7_DEDUP_THRESHOLD:-0.80}"
    export HYATLAS_L7_MAX="${HYATLAS_L7_MAX:-100}"
    export HYATLAS_TOUCH_MIN_SCORE="${HYATLAS_TOUCH_MIN_SCORE:-0.72}"
    # ── LLM：v4.3.0 起 BASE/MODEL/KEY 三项必须齐才调抽取（无内置默认端点）。
    #    默认走本机 Octopus(8081)；MODEL 显式设 flash——不设 model 会被就绪闸判为
    #    unconfigured 而静默停止提取（4.3.0 行为变更，勿回退成"留空"）。
    export HYATLAS_LLM_BASE="${HYATLAS_LLM_BASE:-http://127.0.0.1:8081/v1}"
    export HYATLAS_LLM_MODEL="${HYATLAS_LLM_MODEL:-flash}"
    if [ -z "${HYATLAS_LLM_KEY:-}" ]; then
      # 兜底迁移：现役 v3 配置 llm.api_key → Octopus 通道1 master key
      V3_JSON="${SHARE_ROOT}/config/hy_memory.json"
      if [ -f "$V3_JSON" ]; then
        HYATLAS_LLM_KEY=$(python3 -c "import json;print(json.load(open('$V3_JSON')).get('llm',{}).get('api_key',''))" 2>/dev/null)
        V3_MODEL=$(python3 -c "import json;print(json.load(open('$V3_JSON')).get('llm',{}).get('model',''))" 2>/dev/null)
        # v3 显式配置过 model 时尊重 v3
        [ -n "${V3_MODEL:-}" ] && [ ! -f "$ENV_FILE" ] && HYATLAS_LLM_MODEL="$V3_MODEL"
      fi
      if [ -z "${HYATLAS_LLM_KEY:-}" ]; then
        HYATLAS_LLM_KEY=$(sqlite3 "${TRIM_PKGVAR:-/vol1/@appdata/octopus}/data.db" "SELECT value FROM settings WHERE key='master_key' LIMIT 1;" 2>/dev/null)
      fi
    fi
    export HYATLAS_LLM_KEY="${HYATLAS_LLM_KEY:-}"
    export HYATLAS_LLM_KEY_FILE="${HYATLAS_LLM_KEY_FILE:-}"
    LLM_BASE="$HYATLAS_LLM_BASE"

    if ! is_running; then
      as_user "${APP_DIR}/hyatlas-go" >> "$LOG_FILE" 2>&1 &
      echo $! > "$PID_FILE"
      sleep 2
      if ! is_running; then
        echo "HyAtlas start failed" >&2
        [ -n "${TRIM_TEMP_LOGFILE:-}" ] && echo "HyAtlas 启动失败，查看日志：${LOG_FILE}" > "${TRIM_TEMP_LOGFILE}"
        stop_gw
        exit 1
      fi
    fi

    if ! gw_running; then
      GATEWAY_SOCK_PATH="${APP_DIR}/app.sock" \
      GATEWAY_BACKEND_PORT="19528" \
      GATEWAY_PID_FILE="$GW_PID_FILE" \
        as_user python3 "${APP_DIR}/gateway/gateway_proxy.py" >> "${VAR_DIR}/gateway.log" 2>&1 &
      sleep 1
      if ! gw_running || [ ! -S "${APP_DIR}/app.sock" ]; then
        echo "gateway sidecar start failed" >&2
        [ -n "${TRIM_TEMP_LOGFILE:-}" ] && echo "网关 sidecar 启动失败，查看日志：${VAR_DIR}/gateway.log" > "${TRIM_TEMP_LOGFILE}"
        stop_app
        exit 1
      fi
    fi

    echo "HyAtlas started on port 19528 (user: ${RUN_USER}, gateway socket: ${APP_DIR}/app.sock, data: ${DATA_DIR}, llm: ${LLM_BASE})"
    ;;
  stop)
    stop_gw
    stop_app
    ;;
  status)
    is_running && exit 0 || exit 3
    ;;
  *)
    exit 0
    ;;
esac
