#!/bin/bash
# cmd/uninstall_callback — 卸载双选（v4.7.3-2 合规修复版）
# wizard_delete_data=false → 全保留（share 与 @appdata 都不动，可重装恢复）
# wizard_delete_data=true  → 清 share 内容 + @appdata 日志/PID（不可恢复）
# ⚠️ 本库是 hyatlas 的长期记忆正源，清掉不可恢复；wizard 里已用红字强调。
# 注意：uninstall_callback 里 TRIM_TEMP_LOGFILE 不生效（系统不支持），失败只写自己的日志。
set -u
VAR_DIR="${TRIM_PKGVAR:-/vol1/@appdata/hyatlas}"
APP_DIR="${TRIM_APPDEST:-/vol1/@appcenter/hyatlas}"
PID_FILE="${VAR_DIR}/panel.pid"
GW_PID_FILE="${VAR_DIR}/gateway.pid"
LOG="${VAR_DIR}/uninstall.log"
DATA="${wizard_delete_data:-false}"
mkdir -p "${VAR_DIR}" 2>/dev/null || true
echo "===== uninstall_callback $(date) delete_data=${DATA} =====" >> "$LOG" 2>/dev/null || true

# ── share 根目录：官方两跳解析（与 cmd/main、install/upgrade_callback 逐字同款）──
# 卸载阶段 cmd/ 可能已被清，所以本脚本自带一份，绝不 source 兄弟文件。
resolve_share_root() {
  local _app="$1" _name="$2" _paths="$3" _first _rp _vol _sz
  # ① 只采信「shares 本身是软链」的这一跳：安装器把 shares 重建成实体目录时，那个目录
  #    是系统盘上的全新空壳，路径存在但没货——旧写法据此返回，服务就指向空库（实测踩过）。
  #    同时要求 realpath 落在数据卷 /volN 上，防止把 /var/apps 自身的实体目录当 share。
  if [ -L "/var/apps/${_app}/shares" ]; then
    _rp="$(readlink -f "/var/apps/${_app}/shares/${_name}" 2>/dev/null || true)"
    case "${_rp}" in /vol[1-9]*) printf '%s\n' "${_rp}"; return 0 ;; esac
  fi
  # ② TRIM_DATA_SHARE_PATHS 首段（%%:*，不是 dirname），跳过未落卷的 /vol0/* 占位路径。
  #    该值既可能是 share 父目录（/vol2/@appshare）也可能直接是 <app> 本体，两种形状都吃。
  _first="${_paths%%:*}"
  if [ -n "${_first}" ]; then
    case "${_first}" in
      /vol0/*) : ;;
      */"${_name}") printf '%s\n' "${_first}"; return 0 ;;
      *) if [ -d "${_first}/${_name}" ] || mkdir -p "${_first}/${_name}" 2>/dev/null; then
           printf '%s\n' "${_first}/${_name}"; return 0
         fi ;;
    esac
  fi
  # ③ 救援：在已挂载卷里找「有货」的 share 本体（go-data/doc_index.json > 1MB 视为有货）。
  #    用于 shares 被实体化、且安装器没给 TRIM_DATA_SHARE_PATHS 的场合——宁可找回真库，
  #    也不要在系统盘上另起一个空库。
  for _vol in /vol[1-9]*; do
    [ -d "${_vol}/@appshare/${_name}/go-data" ] || continue
    _sz=$(stat -c %s "${_vol}/@appshare/${_name}/go-data/doc_index.json" 2>/dev/null || echo 0)
    [ -n "${_sz}" ] || _sz=0
    if [ "${_sz}" -gt 1000000 ] 2>/dev/null; then
      printf '%s\n' "${_vol}/@appshare/${_name}"; return 0
    fi
  done
  return 1
}

_cov="${TRIM_SHARE_DIR:-}"
if [ -n "${_cov}" ]; then
  SHARE_ROOT="${_cov%/}/hyatlas"
else
  SHARE_ROOT="$(resolve_share_root hyatlas hyatlas "${TRIM_DATA_SHARE_PATHS:-}")" || SHARE_ROOT=""
fi
SHARE_ROOT="${SHARE_ROOT:-/var/apps/hyatlas/shares/hyatlas}"

# ── 先停进程，避免清数据时服务还在写 ──
# main 脚本与本脚本同目录（/var/apps/<app>/cmd/），卸载阶段 TRIM_APPDEST 可能已被清空
MAIN_SELF="$(cd "$(dirname "$0")" 2>/dev/null && pwd)/main"
if [ -f "$MAIN_SELF" ]; then
  "$MAIN_SELF" stop >/dev/null 2>&1 || true
elif [ -f "${APP_DIR}/cmd/main" ]; then
  "${APP_DIR}/cmd/main" stop >/dev/null 2>&1 || true
fi

# 网关 sidecar（保持原有清理段）
if [ -f "$GW_PID_FILE" ]; then
  gwpid=$(cat "$GW_PID_FILE" 2>/dev/null)
  if [ -n "$gwpid" ] && kill -0 "$gwpid" 2>/dev/null; then
    kill "$gwpid" 2>/dev/null
    sleep 1
    kill -9 "$gwpid" 2>/dev/null || true
  fi
  rm -f "$GW_PID_FILE"
fi

# 面板主进程（保持原有清理段）
if [ -f "$PID_FILE" ]; then
  pid=$(cat "$PID_FILE" 2>/dev/null)
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null
    sleep 3
    kill -9 "$pid" 2>/dev/null || true
  fi
  rm -f "$PID_FILE"
fi

# 兜底：按进程名收拾残留（防 PID 文件错位时留下孤儿进程写 share）
pkill -x hyatlas-go 2>/dev/null || true
pkill -f "gateway_proxy.py" 2>/dev/null || true

rm -f "${APP_DIR}/app.sock" 2>/dev/null || true

case "$DATA" in
  "true")
    # 只清 share 内容，保留目录本体与属主，便于将来重装复用。
    # 用 find 不用 rm -rf "$D"/* —— 通配不匹配 . 开头隐藏文件，会留垃圾。
    if [ -n "${SHARE_ROOT}" ] && [ -d "${SHARE_ROOT}" ]; then
      if find "${SHARE_ROOT}" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null; then
        echo "清除 share 数据内容：${SHARE_ROOT}" >> "$LOG" 2>/dev/null || true
      else
        echo "清除 share 数据失败：${SHARE_ROOT}" >> "$LOG" 2>/dev/null || true
      fi
    else
      echo "share 数据目录不存在，无需清除：${SHARE_ROOT}" >> "$LOG" 2>/dev/null || true
    fi
    # 日志/PID/HOME/TMPDIR 属 @appdata，一并清除（数据真身在 share，不受这里影响）
    if [ -n "${VAR_DIR}" ] && [ -d "${VAR_DIR}" ]; then
      rm -rf "${VAR_DIR}"
      echo "清除 @appdata 运行时目录：${VAR_DIR}" >> "${LOG}" 2>/dev/null || true
    fi
    echo "已按用户选择清除全部应用数据（不可恢复）"
    ;;
  "false"|*)
    # 保留分支：share 与 @appdata 都不动
    echo "保留数据（share ${SHARE_ROOT} 与 @appdata 均不动，可随时重装恢复）"
    echo "keep data (share=${SHARE_ROOT})" >> "$LOG" 2>/dev/null || true
    ;;
esac
exit 0
