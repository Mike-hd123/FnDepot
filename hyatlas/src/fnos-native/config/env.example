# HyAtlas fnOS 配置 — 安装时自动生成于 /vol1/@appdata/hyatlas/env（chmod 600，属主 hy-memory）
# cmd/main 启动时 source 本文件；优先级：shell 环境变量 > 本文件 > main 内置默认
# 修改后需在面板重启 hyatlas 应用生效。
# 模板升级时 upgrade_callback 会把本文件新增的键补入 env（不覆盖你已设的值）。

# ── 抽取模式（v4.3.0 能力档位；决定什么会发去 LLM）──
#   lite   完全不调 LLM；只存 L2 raw + 本地向量（记忆文本不出机器，1/7 层）
#   pro    每次写 1 次抽取；轮内产出 L1/L2/L3/L4/L7（5/7 层）
#   ultra  pro + 定期慢路径整合：L5 知识图谱 / L6 schema / 跨会话 L4 arc / L2 衰减（7/7 层）
HYATLAS_MODE=ultra

# ── LLM（OpenAI 兼容端点。v4.3.0 起无默认端点：BASE/MODEL/KEY 三项缺一即不抽取，
#    状态报 llm=unconfigured，不会凭空外发）。默认指向本机 Octopus 网关。──
HYATLAS_LLM_BASE=http://127.0.0.1:8081/v1
HYATLAS_LLM_MODEL=flash
HYATLAS_LLM_KEY=

# ── 同步抽取（延迟开关，与模式解耦。留空=随模式：pro 阻塞等待、ultra 立即返回）──
#HYATLAS_SYNC_EXTRACT=off

# ── 慢路径调参（仅 ultra 生效）──
#HYATLAS_CONSOLIDATE_EVERY=6h
#HYATLAS_CONSOLIDATE_BATCH=200
# HYATLAS_RAW_RETENTION 不设则 L2 raw 永不删除；设置后被 L5 图边引用的 raw 仍受保护不衰减
#HYATLAS_RAW_RETENTION=90d

# ── Embedding ──
# 默认走本机 embedding wrapper（18080，bge-large-zh-v1.5，1024d）。
# 改为 bge 回退包内进程内 ORT int8（需 APPDEST/models 三件套在位）。
HYATLAS_EMBED_BASE=http://127.0.0.1:18080/v1
HYATLAS_EMBED_MODEL=bge-large-zh-v1.5
#HYATLAS_EMBED_KEY=
# （旧版兼容：若 env 里只有 4.2.0-4 时代的 HYATLAS_EMBED_API_KEY / HYATLAS_LLM_BASE_URL，cmd/main 会自动映射到新键名）

# ── fork 定制：L7 意图防膨胀 / 检索触达 ──
#HYATLAS_L7_DEDUP_THRESHOLD=0.80
#HYATLAS_L7_MAX=100
#HYATLAS_TOUCH_MIN_SCORE=0.72

# ── 4.5.0 新增（本次同步引入的上游能力）──
# HYATLAS_ADMIN：维护端点开关。on 时才允许调用 POST /api/v1/admin/compact_raw 与
#   /api/v1/admin/dedupe_facts；默认关闭(403)。compact_raw **不可逆**(removed text is gone)，
#   执行前先备份 /vol1/@appshare/hyatlas/go-data。跑完请重启服务并去掉本行。
#HYATLAS_ADMIN=on

# HYATLAS_ALLOWED_HOSTS：Host allowlist，逗号分隔的主机名（不含 scheme、不含端口，端口写了会被忽略）。
#   4.5.0 的 guardLocal 会拒绝 Host 是 DNS 名且不在本列表里的请求（防 DNS rebinding）。
#   fnOS 网关路径已把 Host 改写成 127.0.0.1:19528（loopback 字面量永远放行），
#   所以通过 fnOS 面板访问 hyatlas **无需**设本键。仅当你直连 http://<NAS-DNS>:19528/...
#   时才需要把 DNS 名加进来。
#HYATLAS_ALLOWED_HOSTS=

# HYATLAS_CONSOLIDATE_GRAPH：ultra 慢路径是否写 L5 知识图谱边。默认开。
#   off 时 ultra 只剩 6/7 层（不产 L5），且 L5 图谱搜索也失效。
#HYATLAS_CONSOLIDATE_GRAPH=on

# HYATLAS_DEDUPE_SCORE：新事实与旧事实的 cosine 相似度阈值，达到就 supersede 旧的。
#   默认 0.92；设 0 关闭写入时去重。fork 的 HYATLAS_L7_DEDUP_THRESHOLD(0.80) 只管 L7，
#   本键只管 L3 事实层，两者独立。
#HYATLAS_DEDUPE_SCORE=0.92

# HYATLAS_MIN_SCORE：/api/v1/search 默认最低分，低于此分的结果被丢弃。默认 0.60。
#   请求体里带 "min_score": x 可单次覆盖。
#HYATLAS_MIN_SCORE=0.60

# HYATLAS_USER_ALIASES：用户 ID 别名组，格式 "id1,id2;id3,id4"。搜索任一 ID 会覆盖同组
#   全部 ID，适合改过 user_id 的旧库。留空表示无别名。
#HYATLAS_USER_ALIASES=

# ── 4.5.0-2 新增：delete_all 删除护栏 ──
# HYATLAS_DELETE_MAX：单次 POST /api/v1/delete_all 允许删除的行数上限，默认 1000。
#   命中数超过本值时，必须同时带 "confirm_mass_delete": true（或 ?confirm_mass_delete=true）
#   才会真的删，否则返回 429 并告诉你 will_delete 是多少。
#   设 0 表示不限制（保留，但不建议：10-09 事故的 user_id=default 就是这种全库删除）。
#   调小会让插件 hy_memory 的批量删除（默认每批 100 条）更容易被拦；调大放宽。
#HYATLAS_DELETE_MAX=1000

# ── 4.6.0-1 新增（上游 v4.6.0）：时效权重 / 意图 TTL / 自动快照 ──
# HYATLAS_RECENCY：检索是否带时效权重（新的记忆在分数接近时优先）。默认开；设 off 关闭。
#   关闭后新旧条目同分不再偏向新条目（老库排查"为什么这条排前面"时可临时关掉对比）。
#HYATLAS_RECENCY=on

# HYATLAS_INTENTION_TTL：L7 意图在检索结果里的保留时长，默认 7 天（168h）。
#   超过此时长的意图不再出现在 search 结果中（数据仍在库里，/api/v1/list 可见）。
#   v4.6.0 起 L7 不再"永存"，这是意图层降噪的一部分；要恢复旧行为就设一个大值。
#HYATLAS_INTENTION_TTL=168h

# HYATLAS_SNAPSHOT_EVERY：自动快照周期，默认 24h；设 0 关闭自动快照。
#   快照是 go-data 全量 zip（含 doc_index.json + 每条的 .gob），落在 HYATLAS_SNAPSHOT_DIR。
#HYATLAS_SNAPSHOT_EVERY=24h

# HYATLAS_SNAPSHOT_KEEP：保留最近 N 份快照，更旧的自动删，默认 7。
#HYATLAS_SNAPSHOT_KEEP=7

# HYATLAS_SNAPSHOT_DIR：快照落盘目录。默认在 data 目录的同级 snapshots/；
#   ⚠ 若把它指到 data 目录内部，启动时会拒绝并关闭快照（防自我归档）。
#HYATLAS_SNAPSHOT_DIR=

# ---- v4.8.0 / v4.9.0 新增（4.7.x 就有但模板漏记的键一并补齐）----

# HYATLAS_EPISODE_GAP：一段连续工作的间隔，默认 30m。v4.8.0 起「每写一条产一条 L4 摘要」
#   改成「一段工作产一条 L4」，直接省掉大量 LLM 调用。
#   ⚠ "0"/"off"/"false" 会**彻底关掉 L4 产出路径**（每写一条的旧路径已被上游移除），
#     除非你确定不要 L4，否则别关。
#HYATLAS_EPISODE_GAP=30m

# HYATLAS_RECONCILE：v4.9.0 的写后二次对齐——每条写入再花一次 LLM 调用，把新事实与库里
#   相似旧事实做 update/supersede，面向本地模型。**本机保持 off**：octopus 免费额度与
#   延迟都不宽裕，每条多一次调用会同时拖慢实时写入与 02:00 固化链。
#HYATLAS_RECONCILE=off

# HYATLAS_NOW_EVERY：Now page（当前工作记忆页）后台重建周期，默认 15m。
#HYATLAS_NOW_EVERY=15m

# HYATLAS_USAGE_LEARNING：召回使用学习，默认 on（插件 feedback 上报后按使用频率 ±6% 调权）。
#   v4.8.0 修了它的存储：学习数据另存 usage_learning.json，不再与 store 计数器抢 usage.json。
#HYATLAS_USAGE_LEARNING=on

# HYATLAS_EXTRACT_TIMEOUT：单次抽取 LLM 调用超时，默认 300s。免费模型常要几分钟，别调小。
#HYATLAS_EXTRACT_TIMEOUT=300s

# 固化节流三键：并行 1–4（默认 2）；有 pending 时 catch-up 周期（默认 20m）；
# 强制重切主题簇的间隔（留空=不重切）。
#HYATLAS_CONSOLIDATE_PARALLEL=2
#HYATLAS_CONSOLIDATE_CATCHUP=20m
#HYATLAS_CONSOLIDATE_RECLUSTER=

# 备用模型：主 LLM 失败时试备胎。备胎端点在**不同 host** 且没配 _KEY 时不带主 key（防泄露）。
#HYATLAS_LLM_FALLBACK_MODEL=
#HYATLAS_LLM_FALLBACK_BASE=
#HYATLAS_LLM_FALLBACK_KEY=

# ⚠ HYATLAS_LLM_KEY_FILE 自 v4.8.0 起上游明确禁止指向**别的应用**的凭证文件（如 Hermes
#   auth.json）——那是凭证窃取行为模式，会被杀软当成威胁。本机正解：在 fnos env 里显式写
#   HYATLAS_LLM_KEY，或用 v4.8.0 新增的 POST /api/v1/llm/key 运行时交接（只留内存，
#   不落盘、不回显、不写日志）。

# ── 数据目录（v4.9.0-2）──
# 默认由 cmd/main 的 share 两跳解析得出；显式钉死可防 fnOS 安装器把
# /var/apps/hyatlas/shares 重建成实体目录后、服务静默读到系统盘上的空壳库。
# 路径里的卷号按本机实际来（本机真库在 /vol2）：
#HYATLAS_GO_DATA=/vol2/@appshare/hyatlas/go-data
# 允许「空壳库」启动：默认关闭——解析到的 go-data 是空的而别处有 >1MB 的真库时拒绝启动
#（宁可不启动也不往空壳里写）。主动重置数据库时才临时设 on。
#HYATLAS_ALLOW_EMPTY_START=on
