WALIAPI_HOST=127.0.0.1
WALIAPI_PORT=8777
WALIAPI_DATA_DIR=/var/lib/waliapi
WALIAPI_TARGET_HOME=/var/lib/waliapi/managed-home
# Public HTTPS origin used when generating client application configs.
# WALIAPI_PUBLIC_URL=https://waliapi.example.com
# Generate with: openssl rand -hex 32
WALIAPI_ADMIN_TOKEN=replace-with-a-long-random-token
# Separate least-privilege credential for external MCP clients/Agents.
# It must not equal WALIAPI_ADMIN_TOKEN.
WALIAPI_MCP_TOKEN=replace-with-a-different-long-random-token
WALIAPI_WEB_DIR=/opt/waliapi/dist
