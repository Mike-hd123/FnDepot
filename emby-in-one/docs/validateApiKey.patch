+// validateAPIKeyViaUsersList fetches /Users and returns the first user's Id.
+// Used as a fallback when /Users/Me is rejected by custom Emby servers.
+func (c *UpstreamClient) validateAPIKeyViaUsersList(ctx context.Context, reqCtx *RequestContext, identity *ClientIdentityService) string {
+	resp, err := c.doRequestForMode(ctx, reqCtx, http.MethodGet, "/Users", nil, nil, c.requestHeaders(reqCtx, identity), false, authModeAPIKeyValidation)
+	if err != nil {
+		if c.logger != nil {
+			c.logger.Errorf("[%s] /Users fallback failed: %s", c.Name, err.Error())
+		}
+		return ""
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		if c.logger != nil {
+			c.logger.Errorf("[%s] /Users fallback returned %s", c.Name, resp.Status)
+		}
+		return ""
+	}
+	var users []map[string]any
+	if err := json.NewDecoder(resp.Body).Decode(&users); err != nil {
+		if c.logger != nil {
+			c.logger.Errorf("[%s] /Users fallback decode failed: %s", c.Name, err.Error())
+		}
+		return ""
+	}
+	for _, u := range users {
+		if id, _ := u["Id"].(string); id != "" {
+			return id
+		}
+	}
+	return ""
+}
