appname                    = emby-in-one
version                    = 1.4.4-9
display_name               = Emby
desc                       = Emby 聚合反向代理网关 —— 纯 Go 单二进制(静态编译)，解决上游 Emby Boost CDN 签名 URL 900 秒过期导致拖拽 403 问题。redirect 模式每次请求重建上游 URL，支持多用户进度隔离、ID 重写、海报墙透传。监听 TCP 18096。
platform                   = x86
source                     = thirdparty
maintainer                 = ArizeSky
