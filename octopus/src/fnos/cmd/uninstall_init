#!/bin/bash
# 卸载前置：停止服务（对齐现役包逻辑）
set -u
VAR_DIR="${TRIM_PKGVAR:-/var/apps/octopus/var}"
PID_FILE="${VAR_DIR}/panel.pid"

if [ -f "$PID_FILE" ]; then
  pid=$(cat "$PID_FILE" 2>/dev/null)
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null
    sleep 3
    kill -9 "$pid" 2>/dev/null || true
  fi
  rm -f "$PID_FILE"
fi

exit 0
