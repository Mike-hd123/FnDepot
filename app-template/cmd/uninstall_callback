#!/bin/bash
# uninstall_callback — 卸载清理。
#
# fnOS 卸载向导（wizard/uninstall）会弹一个 radio 让用户选择：
#   保留数据（默认，value="false"） 或 清除数据（value="true"）
# 用户选择通过环境变量 $wizard_delete_data 传入本脚本。
#
# systemd 应用还须清 systemd 单元（残留旧 unit 与新 app_id 冲突）：
#   systemctl stop <appname> 2>/dev/null || true
#   systemctl disable <appname> 2>/dev/null || true
#   rm -f /etc/systemd/system/<appname>.service
#   systemctl daemon-reload 2>/dev/null || true
# 非 systemd 应用（PID 文件管理）：按需 pkill 残留进程即可。
#
# Docker 应用：appcenter 卸载只删 DB 记录+应用目录，docker 容器/卷/网络不删 →
# 要在此处手动清，否则重装可能 10500 端口冲突。
set -u

DATA="${wizard_delete_data:-false}"
echo "数据删除选项: ${DATA:-<unset>}"

# 数据根目录：与 cmd/main 完全相同的解析规则（share 才是数据的家）。
# 本脚本自带一份 resolve_share_root：卸载阶段 cmd/ 可能已被清，不能 source 别的文件。
resolve_share_root() {
  local _app="$1" _name="$2" _paths="$3" _c
  for _c in "/var/apps/${_app}/shares/${_name}" "${_paths%%:*}"; do
    [ -n "${_c}" ] || continue
    case "${_c}" in /vol0/*) continue ;; esac
    if [ -d "${_c}" ] || mkdir -p "${_c}" 2>/dev/null; then
      printf '%s\n' "${_c}"
      return 0
    fi
  done
  return 1
}

DATA_ROOT="$(resolve_share_root "<appname>" "<share名>" "${TRIM_DATA_SHARE_PATHS:-}")"
DATA_ROOT="${DATA_ROOT:-/var/apps/<appname>/shares/<share名>}"

# 删数据前先停进程，避免进程还在写（顺序错了会写出半截文件）
MAIN_SELF="$(cd "$(dirname "$0")" 2>/dev/null && pwd)/main"
[ -f "$MAIN_SELF" ] || MAIN_SELF="${TRIM_APPDEST:-/nonexistent}/cmd/main"
[ -f "$MAIN_SELF" ] && "$MAIN_SELF" stop >/dev/null 2>&1 || true

case "$DATA" in
    "true")
        # 只清 share 里的内容，保留目录本身与属主，方便将来重装直接复用
        # 用 find 而不是 `rm -rf "$D"/*`：通配不匹配 . 开头的隐藏文件，会留垃圾
        echo "卸载前清除 share 数据内容：${DATA_ROOT}"
        if [ -n "${DATA_ROOT}" ] && [ -d "${DATA_ROOT}" ]; then
            find "${DATA_ROOT}" -mindepth 1 -maxdepth 1 -exec rm -rf {} + \
              && echo "share 内容清除成功" || echo "清除失败" >&2
        else
            echo "share 数据目录不存在，无需清除"
        fi
        # 配置/日志/PID 属 @appdata，随应用一并清除（不可恢复）
        if [ -n "${TRIM_PKGVAR:-}" ] && [ -d "${TRIM_PKGVAR}" ]; then
            rm -rf "${TRIM_PKGVAR}"
        fi
        ;;
    "false"|*)
        echo "保留数据文件（share 数据与 @appdata 配置均不动，可随时重装恢复）"
        ;;
esac

exit 0
