#!/bin/bash
# uninstall_callback — 卸载清理。
#
# fnOS 卸载向导（wizard/uninstall）会弹一个 radio 让用户选择：
#   保留数据（默认，value="false"） 或 清除数据（value="true"）
# 用户选择通过环境变量 $wizard_delete_data 传入本脚本。
#
# systemd 应用还须清 systemd 单元（残留旧 unit 与新 app_id 冲突）：
#   systemctl stop <appname> 2>/dev/null || true
#   systemctl disable <appname> 2>/dev/null || true
#   rm -f /etc/systemd/system/<appname>.service
#   systemctl daemon-reload 2>/dev/null || true
# 非 systemd 应用（PID 文件管理）：按需 pkill 残留进程即可。
#
# Docker 应用：appcenter 卸载只删 DB 记录+应用目录，docker 容器/卷/网络不删 →
# 要在此处手动清，否则重装可能 10500 端口冲突。
set -u

DATA="${wizard_delete_data:-false}"
echo "数据删除选项: ${DATA:-<unset>}"
case "$DATA" in
    "true")
        echo "卸载前删除数据目录：$TRIM_PKGVAR"
        if [ -n "${TRIM_PKGVAR:-}" ] && [ -d "$TRIM_PKGVAR" ]; then
            rm -rf "$TRIM_PKGVAR" && echo "删除成功" || echo "删除失败" >&2
        else
            echo "目录不存在或 TRIM_PKGVAR 未设置，无需删除"
        fi
        ;;
    "false"|*)
        echo "保留数据文件"
        ;;
esac

exit 0
