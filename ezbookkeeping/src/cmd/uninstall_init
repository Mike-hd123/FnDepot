#!/bin/bash
# 卸载前置：停止服务（数据目录 @appdata/ezbookkeeping 保留，由 fnOS 默认策略处理）
set -uo pipefail
APP_NAME="${TRIM_APPNAME:-ezbookkeeping}"
APP_DIR="${TRIM_APPDEST:-/var/apps/${APP_NAME}}"
APP_VOL=""
if [ -n "${TRIM_PKGVAR:-}" ]; then
    DATA_DIR="${TRIM_PKGVAR}"
else
    if [ -L "${APP_DIR}/home" ]; then
        APP_HOME="$(readlink -f "${APP_DIR}/home")"
        APP_VOL="$(printf '%s' "${APP_HOME}" | sed -n 's#^\(/vol[^/]*\)/.*#\1#p')"
    fi
    [ -z "${APP_VOL}" ] && APP_VOL="$(printf '%s' "${APP_DIR}" | sed -n 's#^\(/vol[^/]*\)/.*#\1#p')"
    if [ -n "${APP_VOL}" ]; then
        DATA_DIR="${APP_VOL}/@appdata/${APP_NAME}"
    else
        DATA_DIR="${APP_DIR}/var"
    fi
fi
CONF="${DATA_DIR}/ezbookkeeping.ini"
if [ -f "${DATA_DIR}/ezbookkeeping.pid" ]; then
    kill "$(cat "${DATA_DIR}/ezbookkeeping.pid" 2>/dev/null)" 2>/dev/null || true
    rm -f "${DATA_DIR}/ezbookkeeping.pid"
fi
# 兜底清残留进程
if [ -d "${APP_DIR}/server" ]; then
    pkill -f "^${APP_DIR}/server/ezbookkeeping server run --conf-path ${CONF}" 2>/dev/null || true
elif [ -d "${APP_DIR}/target/server" ]; then
    pkill -f "^${APP_DIR}/target/server/ezbookkeeping server run --conf-path ${CONF}" 2>/dev/null || true
fi
exit 0
