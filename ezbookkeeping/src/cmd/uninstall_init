#!/bin/bash
# 卸载前置：停止服务。数据与配置真身在 data-share「ezbookkeeping」，
# 保留/清除由 wizard/uninstall 的 wizard_delete_data 决定，具体清理在 uninstall_callback。
set -uo pipefail
APP_NAME="${TRIM_APPNAME:-ezbookkeeping}"
APP_DIR="${TRIM_APPDEST:-/var/apps/${APP_NAME}}"
VAR_DIR="${TRIM_PKGVAR:-/vol2/@appdata/${APP_NAME}}"

# share 解析（两跳；本脚本自带一份，禁止 source 兄弟文件）
resolve_share_root() {
    local _app="$1" _name="$2" _paths="$3" _c
    for _c in "/var/apps/${_app}/shares/${_name}" "${_paths%%:*}"; do
        [ -n "${_c}" ] || continue
        case "${_c}" in /vol0/*) continue ;; esac
        if [ -d "${_c}" ] || mkdir -p "${_c}" 2>/dev/null; then
            printf '%s\n' "${_c}"
            return 0
        fi
    done
    return 1
}

# 带 `|| true`：本脚本是 set -uo pipefail（无 -e），resolve 非零当前不会终止脚本，
#    但保留 || true 让下一行兜底赋值在任何 set 配置下都生效；若日后误加 set -e，
#    可避免下面的 PID kill / pkill 残留进程被跳过 → 卸载时进程未停、删数据半截。
SHARE_ROOT="$(resolve_share_root "${APP_NAME}" ezbookkeeping "${TRIM_DATA_SHARE_PATHS:-}")" || true
SHARE_ROOT="${SHARE_ROOT:-/var/apps/ezbookkeeping/shares/ezbookkeeping}"
CONF="${SHARE_ROOT}/ezbookkeeping.ini"

# PID 文件在 @appdata（运行态文件），配置真身在 share
if [ -f "${VAR_DIR}/ezbookkeeping.pid" ]; then
    kill "$(cat "${VAR_DIR}/ezbookkeeping.pid" 2>/dev/null)" 2>/dev/null || true
    rm -f "${VAR_DIR}/ezbookkeeping.pid"
fi
if [ -f "${VAR_DIR}/gateway.pid" ]; then
    kill "$(cat "${VAR_DIR}/gateway.pid" 2>/dev/null)" 2>/dev/null || true
    rm -f "${VAR_DIR}/gateway.pid"
fi
# 兜底清残留进程（命令行里是 share 的配置路径）
if [ -d "${APP_DIR}/server" ]; then
    pkill -f "^${APP_DIR}/server/ezbookkeeping server run --conf-path ${CONF}" 2>/dev/null || true
elif [ -d "${APP_DIR}/target/server" ]; then
    pkill -f "^${APP_DIR}/target/server/ezbookkeeping server run --conf-path ${CONF}" 2>/dev/null || true
fi
exit 0
