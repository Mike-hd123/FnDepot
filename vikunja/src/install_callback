#!/bin/bash
# 安装后 hook: 写 systemd 单元 + 生成 config.yml（仅缺省时）+ 数据目录 + 权限
# 对齐 skill 坑 #18「占位符自举」：config.yml 只在不存在时生成，用户已有配置永不覆盖
LOG=/tmp/vk_install.log
exec >> "$LOG" 2>&1
echo "==================== install_callback $(date '+%F %T') ===================="
echo "env: TRIM_APPDEST=${TRIM_APPDEST:-<unset>} TRIM_PKGVAR=${TRIM_PKGVAR:-<unset>} TRIM_SERVICE_PORT=${TRIM_SERVICE_PORT:-<unset>} TRIM_APPNAME=${TRIM_APPNAME:-<unset>} euid=$(id -u)"
set -x
set -e
APP="vikunja"
SERVICE="vikunja"
SIDECAR="vikunja-sidecar"
UNIT="/etc/systemd/system/${SERVICE}.service"
# 卷探测：env 缺失时扫描实际安装卷（安装器部分 callback 调用不带 TRIM_* env）
APP_DIR="${TRIM_APPDEST:-}"
if [ -z "${APP_DIR}" ]; then
  for v in /vol1 /vol2 /vol3 /vol4; do
    [ -f "${v}/@appcenter/vikunja/vikunja" ] && APP_DIR="${v}/@appcenter/vikunja" && break
  done
  [ -n "${APP_DIR}" ] || APP_DIR="/vol2/@appcenter/vikunja"
fi
APPDATA="${TRIM_PKGVAR:-}"
if [ -z "${APPDATA}" ]; then
  APP_VOL="$(printf '%s' "${APP_DIR}" | sed -n 's#^\(/vol[^/]*\)/.*#\1#p')"
  [ -n "${APP_VOL}" ] && APPDATA="${APP_VOL}/@appdata/vikunja" || APPDATA="/var/apps/vikunja/var"
fi
PORT="${TRIM_SERVICE_PORT:-3456}"
BIN="${APP_DIR}/vikunja"

# 运行用户单一事实源：fnOS 依 config/privilege 注入 TRIM_USERNAME/TRIM_GROUPNAME，
# 缺失时兜底 vikunja（与 privilege 声明的 username/groupname=vikunja 一致）。
# systemd unit 的 User/Group、SHARE_ROOT/APPDATA 的 chown、config/resource 的
# data-share permission.rw 三者必须同源，否则全新安装（无本机 override.conf）会
# 因数据目录 ACL 只授 vikunja 而 unit 以别的用户跑 → 待办库不可写、服务起不来。
RUN_USER="${TRIM_USERNAME:-vikunja}"
RUN_GROUP="${TRIM_GROUPNAME:-vikunja}"

# ── 失败要让用户看得见（TRIM_TEMP_LOGFILE 在 install_* 里有效，应用中心界面可见）──
die() {
  echo "FATAL: $1" >&2
  [ -n "${TRIM_TEMP_LOGFILE:-}" ] && echo "FATAL: $1" > "${TRIM_TEMP_LOGFILE}"
  exit 1
}

# ── 数据落点 = data-share（v2.7.0-2 本轮合规修复）──
# config/resource 早就声明了 data-share(name=vikunja)，但 v2.7.0-1 及以前脚本没用它：
# vikunja.db / files / logs 全落在 @appdata，用户文件管理器里看不到 = 声明与实现脱节。
# 两跳解析（与 cmd_main / upgrade_callback / uninstall_callback 逐字一致，禁止 source 兄弟文件）：
#   1) /var/apps/<app>/shares/<name> —— fnOS 维护的软链，永远指向真实卷（实测系统用复数 shares/）
#   2) ${TRIM_DATA_SHARE_PATHS} 首段（官方写法 ${VAR%%:*}，取首段；dirname 写法已证伪：
#      安装阶段该变量是未落卷占位 /vol0/@appshare/vikunja，拼出的目录建不动）
resolve_share_root() {
  local _app="$1" _name="$2" _paths="$3" _c
  for _c in "/var/apps/${_app}/shares/${_name}" "${_paths%%:*}"; do
    [ -n "${_c}" ] || continue
    case "${_c}" in /vol0/*) continue ;; esac
    if [ -d "${_c}" ] || mkdir -p "${_c}" 2>/dev/null; then
      printf '%s\n' "${_c}"
      return 0
    fi
  done
  return 1
}

# ⚠️ 必须带 `|| true`：本脚本 set -e，resolve 非零会让整条赋值语句非零 → 立刻终止脚本，
#    于是下面第 58 行的 die 兜底、systemd unit 生成、sidecar 单元、chown、
#    ui/config 端口模式改写与 entry SQL 全被跳过 → 装了但没写 unit，重启后起不来。
SHARE_ROOT="$(resolve_share_root vikunja vikunja "${TRIM_DATA_SHARE_PATHS:-}")" || true
[ -n "${SHARE_ROOT}" ] || die "data-share 目录不可用（TRIM_DATA_SHARE_PATHS=${TRIM_DATA_SHARE_PATHS:-<unset>}），请检查 config/resource 的 data-share 声明"
DATA_DIR="${SHARE_ROOT}/data"
CFG_FILE="${SHARE_ROOT}/config.yml"
mkdir -p "${DATA_DIR}" "${SHARE_ROOT}/files" "${SHARE_ROOT}/logs"
# 运行区只留日志/PID：@appdata 仍建着，兼容旧 boot.log 与 sidecar 的 gateway.pid 清理
mkdir -p "${APPDATA}/logs"

# ── 幂等迁移：老 @appdata 有数据、且 share 目标为空，才 cp -a（源永不删、绝不 mv）──
# vikunja.db 是用户待办的唯一事实源，迁移必须极端保守。
MIGLOG="${APPDATA}/migrate.log"
# 注意：WAL 模式下 db-wal/db-shm 必须一起搬（2026-10-28 实测：只拷主库会丢未 checkpoint 的写入）。
for pair in "vikunja.db:${DATA_DIR}/vikunja.db" "vikunja.db-wal:${DATA_DIR}/vikunja.db-wal" "vikunja.db-shm:${DATA_DIR}/vikunja.db-shm" "files:${DATA_DIR}/files" "logs:${DATA_DIR}/logs"; do
  OLD_NAME="${pair%%:*}"; NEW_PATH="${pair#*:}"
  OLD_PATH="${APPDATA}/${OLD_NAME}"
  if [ -e "${OLD_PATH}" ] && [ ! -e "${NEW_PATH}" ]; then
    cp -a "${OLD_PATH}" "${NEW_PATH}" 2>/dev/null \
      && echo "migrated: ${OLD_PATH} -> ${NEW_PATH}" >> "${MIGLOG}" 2>/dev/null || true
  fi
done
# 老 config.yml（含 JWTSecret / DB 路径）整体搬进 share；share 已有则绝不覆盖
if [ -f "${APPDATA}/config.yml" ] && [ ! -f "${CFG_FILE}" ]; then
  cp -a "${APPDATA}/config.yml" "${CFG_FILE}" 2>/dev/null \
    && echo "migrated: ${APPDATA}/config.yml -> ${CFG_FILE}" >> "${MIGLOG}" 2>/dev/null || true
fi
# .backup 全量备份文件也一并保进 share（保命用，绝不丢）
for b in "${APPDATA}"/vikunja.db.bak_* "${APPDATA}"/vikunja.db.backup*; do
  [ -f "$b" ] || continue
  [ -e "${DATA_DIR}/$(basename "$b")" ] && continue
  cp -a "$b" "${DATA_DIR}/" 2>/dev/null \
    && echo "migrated: $b -> ${DATA_DIR}/" >> "${MIGLOG}" 2>/dev/null || true
done

# ── 二进制就位校验（app.tgz 平铺解到 APPDEST）──
if [ ! -x "${BIN}" ]; then
  echo "ERROR: binary missing at ${BIN}" >&2
  [ -n "${TRIM_TEMP_LOGFILE:-}" ] && echo "Vikunja 二进制缺失：${BIN}" > "${TRIM_TEMP_LOGFILE}"
  exit 1
fi
chmod 755 "${BIN}"

# ── config.yml：不存在才生成（升级/重装保用户配置）──
# v2.7.0-2：配置真身改放 share（@appcenter 升级被替换、@appdata 用户不可见），
# 且 DB/文件/日志路径一并指向 share；老配置已在上方幂等搬到 ${CFG_FILE}。
if [ ! -f "${CFG_FILE}" ]; then
  if [ -f "${APP_DIR}/config.yml.sample" ]; then
    cp "${APP_DIR}/config.yml.sample" "${CFG_FILE}"
  fi
  cat > "${CFG_FILE}" <<EOS
service:
  JWTSecret: "$(openssl rand -hex 16 2>/dev/null || head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
  interface: ":${PORT}"
  enableregistration: false
  timezone: "Asia/Shanghai"
  publicurl: ""
  enablecaldav: true
  enabletaskattachments: true
database:
  type: sqlite
  path: "${DATA_DIR}/vikunja.db"
files:
  basepath: "${DATA_DIR}/files"
log:
  path: "${DATA_DIR}/logs"
  enabled: true
  level: INFO
cors:
  enable: false
EOS
  echo "generated default config.yml at ${CFG_FILE}"
else
  echo "keeping existing config.yml at ${CFG_FILE}"
  # 老配置里若还写着 @appdata 的 DB/files/log 路径，按 share 重写（先备份，只改这三行）
  if grep -q "${APPDATA}/" "${CFG_FILE}" 2>/dev/null; then
    cp -a "${CFG_FILE}" "${CFG_FILE}.bak_$(date +%Y%m%d_%H%M%S)" 2>/dev/null || true
    sed -i \
      -e "s#^\(  path: \).*vikunja\.db.*#\1\"${DATA_DIR}/vikunja.db\"#" \
      -e "s#^\(  basepath: \).*#\1\"${DATA_DIR}/files\"#" \
      "${CFG_FILE}" 2>/dev/null || true
    # log.path 与 basepath 同名 key 风险：只改 log 段那条（用 awk 限定段）
    awk -v p="${DATA_DIR}/logs" '
      /^log:/ {inlog=1} /^[a-z]/ && !/^log:/ {inlog=0}
      inlog && /^  path:/ {sub(/^  path:.*/, "  path: \"" p "\""); }
      {print}
    ' "${CFG_FILE}" > "${CFG_FILE}.tmp" 2>/dev/null && mv "${CFG_FILE}.tmp" "${CFG_FILE}" 2>/dev/null || true
    echo "rewrote @appdata paths in config.yml to share"
  fi
fi

# ── 运行区属主：chown 统一在 unit 生成之后做一次（见文末），此处不重复 chown
#    （旧版在此 chown vikunja:vikunja，文末又 chown hermes-studio 覆盖，读者易误判谁覆盖谁）

# ── systemd 单元（User/Group 用上面的 RUN_USER/RUN_GROUP 单一事实源，与
#    config/privilege 的 username、data-share permission 三者同源）──
cat > "${UNIT}" <<EOS
[Unit]
Description=Vikunja Todo (fnOS app)
After=network.target

[Service]
Type=simple
User=${RUN_USER}
Group=${RUN_GROUP}
WorkingDirectory=${SHARE_ROOT}
Environment=VIKUNJA_SERVICE_INTERFACE=:${PORT}
ExecStart=${BIN} --config ${CFG_FILE}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOS
chmod 644 "${UNIT}"
systemctl daemon-reload
systemctl enable "${SERVICE}" >/dev/null 2>&1 || true

# ── vikunja-sidecar systemd 单元（v9：sidecar 不再 nohup 裸跑）──
# ExecStartPost 清理 nohup 时代遗留的 gateway.pid，防残留 PID 干扰
if [ -f "${APP_DIR}/gateway/gateway_proxy.py" ]; then
  chmod 755 "${APP_DIR}/gateway/gateway_proxy.py"
  cat > "/etc/systemd/system/${SIDECAR}.service" <<EOS
[Unit]
Description=Vikunja Gateway Sidecar (fnOS app socket entry)
After=${SERVICE}.service
BindsTo=${SERVICE}.service

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'rm -f ${APPDATA}/gateway.pid /var/run/vikunja-gw.pid'
ExecStart=/usr/bin/python3 ${APP_DIR}/gateway/gateway_proxy.py
Environment=GATEWAY_SOCK_PATH=${APP_DIR}/app.sock
Environment=GATEWAY_BACKEND_PORT=${PORT}
Environment=GATEWAY_PID_FILE=/var/run/vikunja-gw.pid
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
EOS
  chmod 644 "/etc/systemd/system/${SIDECAR}.service"
  systemctl daemon-reload
fi

# 数据目录属主（unit 的 User=${RUN_USER}，chown 必须同源；share 与运行区各授一次，
# 此处是唯一一次 chown，上方重复的 chown 已合并到这里）
chown -R ${RUN_USER}:${RUN_GROUP} "${SHARE_ROOT}" 2>/dev/null || true
chown -R ${RUN_USER}:${RUN_GROUP} "${APPDATA}" 2>/dev/null || true

# ── v13：把桌面入口从路径反代切到直连端口模式 ──
# 根因（v13 实测确认，对照实验坐实）：
#   1. entry.url 走路径反代还是端口直连，唯一决定字段 = target/ui/config 里的
#      gatewaySocket / gatewayPrefix —— appcenter **每次** start/reinstall 都会重读
#      这个文件重建 entry（对照实验：ui/config 已是端口版 + entry 手动 UPDATE 成端口
#      之后，再 appcenter-cli stop && start，url 和 gateway_socket 都保持端口不回滚，
#      仅 entry.micro_app 列被翻回 t 但**不影响 URL**）。
#   2. 之前"appcenter 只在首装读一次"的假设不精确——它其实每次 start 都读；只是首次
#      安装时 callback 早于 appcenter 建 entry，所以 callback 得**主动 UPDATE SQL 兜底**
#      让首装当次立刻是端口模式，之后每次 start 由 ui/config 保证持久。
#   3. hermes-studio / wechat-on-cloud 端口模式，正是因为它们 target/ui/config 里没有
#      gatewaySocket 字段（首装即端口）。对照：hyatlas/octopus 的 ui/config 有 socket。
#   4. 单纯改 manifest（micro_app/service_port/desktop_uidir）无效（v12 已证死路）。
#
# 对策（v13 实测验证过的组合拳，双保险）：
#   a) 重写 target/ui/config 去 gatewaySocket —— **持久机制**：appcenter 每次 start 读
#      它重建 entry，所以这一改让端口模式跨 start/重启都稳定。app.tgz 源头模板已同步
#      改端口版（见 src/ui-config.json），双保险。
#   b) 立即 UPDATE entry 表 SQL —— **首装当次兜底**：appcenter 建 entry 早于 callback
#      运行，SQL 强制把这条记录切成端口。
#   c) 后台延时 30s 再 UPDATE 一次 —— 防御性双保险：覆盖 appcenter 在 callback 返回后
#      可能自动 start（此时它读的是新 ui/config，理论不回滚，但多压一次不亏）。
#   d) 重启 trim_http_cgi + trim_open_gateway —— nginx 反代/网关缓存失效。
#   e) 不主动 appcenter-cli start —— 让 appcenter 自己走完启动流程。
#
# 手机端 /app/vikunja 反代依然可用（sidecar 保留 + gateway 按 app_name 路由），
# 桌面图标从反代 /app/vikunja 切到直连 :3456 端口。
# 实际布局：app.tgz 解到 target/（软链到 @appcenter/<app>），ui/config 在 target 下
UI_CONFIG="${APP_DIR}/target/ui/config"
[ -f "${UI_CONFIG}" ] || UI_CONFIG="${APP_DIR}/ui/config"
if [ -f "${UI_CONFIG}" ]; then
  echo "[v13] rewriting ${UI_CONFIG} — removing gatewaySocket/gatewayPrefix for direct-port mode"
  cp -f "${UI_CONFIG}" "${UI_CONFIG}.bak_$(date +%Y%m%d_%H%M%S)" 2>/dev/null || true
  cat > "${UI_CONFIG}" <<JSONEOF
{
  ".url": {
    "vikunja.panel": {
      "title": "待办",
      "icon": "images/icon-{0}.png",
      "type": "iframe",
      "protocol": "",
      "port": ${PORT},
      "url": "/",
      "allUsers": true
    }
  }
}
JSONEOF
  chmod 644 "${UI_CONFIG}"
  chown root:root "${UI_CONFIG}" 2>/dev/null || true
fi

# entry 表 SQL 改写函数（幂等）
_update_entry_url() {
  local port="$1"
  sudo -u postgres psql -d trim_sac -v ON_ERROR_STOP=1 -Atc \
    "UPDATE entry SET url='{\"port\":\"${port}\",\"path\":\"/\"}', gateway_socket='', gateway_prefix='' WHERE app_name='vikunja' AND service_name='vikunja.panel';" \
    >/dev/null 2>&1
}

if command -v psql >/dev/null 2>&1 && [ -S /var/run/postgresql/.s.PGSQL.5432 ]; then
  # a) 立即改一次
  if _update_entry_url "${PORT}"; then
    echo "[v13] entry.url switched to direct-port mode (port=${PORT})"
  else
    echo "[v13][WARN] initial entry.url UPDATE failed"
  fi

  # b) 后台延时 30s 再改一次，覆盖 appcenter start 触发的回滚
  # 30s 是 appcenter start + 应用起来 + entry 刷新 的保守窗口
  (
    sleep 30
    if command -v psql >/dev/null 2>&1 && [ -S /var/run/postgresql/.s.PGSQL.5432 ]; then
      _update_entry_url "${PORT}" && echo "[v13] delayed entry.url UPDATE ok" \
        || echo "[v13][WARN] delayed entry.url UPDATE failed"
    fi
  ) &
  disown 2>/dev/null || true
else
  echo "[v13][WARN] psql or postgresql socket missing — skipping entry.url switch"
fi

# c) 三服务重启（反代 reload / 网关路由刷新）—— 应用本体不在此重启，
#    让 appcenter 自然完成启动流程
for svc in trim_http_cgi trim_open_gateway; do
  systemctl restart "${svc}" >/dev/null 2>&1 && echo "[v13] restarted ${svc}" \
    || echo "[v13][WARN] restart ${svc} failed"
done

echo "vikunja install_callback done (APPDEST=${APP_DIR}, APPDATA=${APPDATA}, PORT=${PORT})"
