#!/bin/bash
# cmd/main — Vikunja 进程管理（v9：sidecar 由 systemd 单元 vikunja-sidecar 托管）
# 应用 = systemd 单元（原生二进制，User/Group 由 install_callback 依 config/privilege 的
#       username/groupname（兜底 vikunja）写入 base unit，与 data-share permission 同源）
# sidecar = vikunja-sidecar 单元（socket 自注册，root 跑 —— 需在 APPDEST 建 app.sock）
set -u

SERVICE="vikunja"
SIDECAR="vikunja-sidecar"

# 失败要让用户看得见（TRIM_TEMP_LOGFILE 在 main/install_*/upgrade_* 里有效，应用中心界面可见）
die() {
  echo "FATAL: $1" >&2
  [ -n "${TRIM_TEMP_LOGFILE:-}" ] && echo "FATAL: $1" > "${TRIM_TEMP_LOGFILE}"
  exit 1
}

# 卷探测：env 缺失时扫描实际安装卷
APP_DIR="${TRIM_APPDEST:-}"
if [ -z "${APP_DIR}" ]; then
  for v in /vol1 /vol2 /vol3 /vol4; do
    [ -f "${v}/@appcenter/vikunja/vikunja" ] && APP_DIR="${v}/@appcenter/vikunja" && break
  done
  [ -n "${APP_DIR}" ] || APP_DIR="/vol2/@appcenter/vikunja"
fi
# ── 运行区（日志/PID/boot.log）：@appdata，卷探测兜底 ──
VAR_DIR="${TRIM_PKGVAR:-}"
if [ -z "${VAR_DIR}" ]; then
  APP_VOL="$(printf '%s' "${APP_DIR}" | sed -n 's#^\(/vol[^/]*\)/.*#\1#p')"
  if [ -n "${APP_VOL}" ]; then
    VAR_DIR="${APP_VOL}/@appdata/vikunja"
  else
    VAR_DIR="/var/apps/vikunja/var"
  fi
fi

# ── 数据区（vikunja.db / files / storage / .backup）：必须落 data-share ──
# config/resource 已声明 data-share(name=vikunja)，但 v2.7.0-1 及以前脚本没用它，
# 数据实际全在 @appdata —— 声明与实现脱节，用户文件管理器里根本看不到，属合规缺陷。
# 老写法（对该变量取 dirname 再拼 share 名）禁用：安装阶段该变量是未落卷占位路径
# /vol0/@appshare/vikunja，拼出的目录不存在也建不动。正解见下（两跳，与其余三个脚本逐字一致）：
#   1) /var/apps/<app>/shares/<name> —— fnOS 自己维护的软链，永远指向真实卷（实测系统用复数 shares/）
#   2) ${TRIM_DATA_SHARE_PATHS} 首段（官方写法 ${VAR%%:*}，取首段，不是 dirname）
resolve_share_root() {
  local _app="$1" _name="$2" _paths="$3" _c
  for _c in "/var/apps/${_app}/shares/${_name}" "${_paths%%:*}"; do
    [ -n "${_c}" ] || continue
    case "${_c}" in /vol0/*) continue ;; esac
    if [ -d "${_c}" ] || mkdir -p "${_c}" 2>/dev/null; then
      printf '%s\n' "${_c}"
      return 0
    fi
  done
  return 1
}

SHARE_ROOT="$(resolve_share_root vikunja vikunja "${TRIM_DATA_SHARE_PATHS:-}")" \
  || die "找不到 data-share 目录，请检查 config/resource 的 data-share 声明"
DATA_DIR="${SHARE_ROOT}/data"
PORT="${TRIM_SERVICE_PORT:-3456}"
BOOT_LOG="${VAR_DIR}/boot.log"

mkdir -p "${VAR_DIR}" "${DATA_DIR}" 2>/dev/null || true
# 老数据（@appdata）不是本脚本搬的：迁移统一由 install_callback / upgrade_callback 做
# （这里只保证目录存在，绝不 mv、绝不覆盖已有 share 数据）

log() { echo "[$(date '+%F %T')] $*" >> "${BOOT_LOG}" 2>/dev/null || true; }

port_ready() {
  curl -s --max-time 2 "http://127.0.0.1:${PORT}/api/v1/info" >/dev/null 2>&1
}

sock_ready() {
  [ -S "${APP_DIR}/app.sock" ] || [ -S "${APP_DIR}/target/app.sock" ]
}

start() {
  if systemctl is-active --quiet "${SERVICE}" 2>/dev/null; then
    log "app already running"
  else
    log "starting systemd unit ${SERVICE}"
    systemctl start "${SERVICE}" || true
    local ok=0
    for i in $(seq 1 20); do
      if port_ready; then ok=1; break; fi
      sleep 1
    done
    if [ "${ok}" != "1" ]; then
      log "ERROR: ${SERVICE} failed to start on port ${PORT}"
      [ -n "${TRIM_TEMP_LOGFILE:-}" ] && echo "Vikunja 启动失败，查看日志：journalctl -u ${SERVICE} -n 50" > "${TRIM_TEMP_LOGFILE}"
      exit 1
    fi
    log "app started on port ${PORT}"
  fi
  # sidecar（手机/桌面网关统一入口）：失败不阻塞应用本身（应用数据无恙，入口可后补）
  if [ -f "${APP_DIR}/gateway/gateway_proxy.py" ]; then
    systemctl enable --now "${SIDECAR}" >/dev/null 2>&1 || systemctl start "${SIDECAR}" >/dev/null 2>&1 || true
    local sok=0
    for i in $(seq 1 5); do
      if sock_ready; then sok=1; break; fi
      sleep 1
    done
    if [ "${sok}" = "1" ]; then
      log "gateway sidecar ready (${APP_DIR}/app.sock -> 127.0.0.1:${PORT})"
    else
      log "WARN: gateway sidecar not ready (check journalctl -u ${SIDECAR})"
    fi
  else
    log "WARN: gateway script missing, socket entry disabled"
  fi
  log "start complete"
}

stop() {
  systemctl stop "${SIDECAR}" 2>/dev/null || true
  systemctl stop "${SERVICE}" 2>/dev/null || true
  log "stopped"
}

status() {
  if systemctl is-active --quiet "${SERVICE}" 2>/dev/null; then
    echo "running"
    return 0
  fi
  echo "stopped"
  return 1
}

case "${1:-}" in
  start)   start ;;
  stop)    stop ;;
  restart) stop; start ;;
  status)  status ;;
  *)       exit 0 ;;
esac
